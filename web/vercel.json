{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "sveltekit",
  "outputDirectory": "build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/support",
      "permanent": false
    }
  ],
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile"
}
