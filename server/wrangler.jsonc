{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "touchtips-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "dev": { "port": 8788 },
  "vars": {
    // The origin MCP clients connect to. Override per environment below.
    "PUBLIC_URL": "http://localhost:8788"
  },
  // Replace the placeholder ids after `wrangler kv namespace create OAUTH_KV`
  // and `wrangler d1 create touchtips`. Local dev ignores the ids.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "touchtips-snapshots" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "touchtips", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "env": {
    "production": {
      "vars": { "PUBLIC_URL": "https://mcp.touchtips.app" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "touchtips-snapshots" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "touchtips", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
      ],
      "routes": [{ "pattern": "mcp.touchtips.app", "custom_domain": true }]
    }
  }
}
